diff --git a/vertical-collection/src/-private/utils/define-tracked.ts b/vertical-collection/src/-private/utils/define-tracked.ts
new file mode 100644
index 0000000..f505415
--- /dev/null
+++ b/vertical-collection/src/-private/utils/define-tracked.ts
@@ -0,0 +1,10 @@
+import { tracked } from '@glimmer/tracking';
+
+export default function defineTracked(prototype: object, key: string) {
+  Object.defineProperty(
+    prototype,
+    key,
+    // @ts-ignore the decorator form, called directly
+    tracked(prototype, key, { enumerable: true, configurable: true, writable: true }) as PropertyDescriptor,
+  );
+}
